<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="styles.css" />
    <title><%= title %></title>
  </head>
  <body>
    <h1><%= title %></h1>
    <% items.forEach((item) => { %>
    <div>
      <%= item.category %>, <%= item.item %> , <%= item.manufacturer %>, $<%=
      item.price/100 %>
    </div>
    <% }) %>
  </body>
</html>
