<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="styles.css" />
    <title><%= title %></title>
  </head>
  <body>
    <div class="wrapper">
      <h1 class="title"><%= title %></h1>
      <div class="buttonLinkContainer">
        <a href="/items" class="buttonLink">All Matcha Powder</a>
        <a href="/new/category" class="buttonLink">Add Matcha Grade</a>
        <a href="/new/item" class="buttonLink">Add Matcha Powder</a>
      </div>
      <div class="categoryContainer">
        <% categories.forEach((row) => { %>
        <a href="/<%= row.category.toLowerCase() %>" class="category">
          <h2><%= row.category %> Grade</h2>
        </a>
        <% }) %>
      </div>
    </div>
  </body>
</html>
