<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="styles.css" />
    <title><%= title %></title>
  </head>
  <body>
    <div class="wrapper">
      <h1 class="title"><%= title %></h1>
      <a href="/items">All Matcha Powder</a>
      <a href="/new/category">Add Matcha Grade</a>
      <a href="/new/item">Add Matcha Powder</a>
      <% categories.forEach((row) => { %>
      <a href="/<%= row.category.toLowerCase() %>">
        <h2><%= row.category %> Grade</h2>
      </a>
      <% }) %>
    </div>
  </body>
</html>
