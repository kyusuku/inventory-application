<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css" />
    <title><%= title %></title>
  </head>
  <body>
    <div class="wrapper">
      <h1>Delete Category: <%= title %></h1>
      <% if (error) { %>
      <p style="color: red"><%= error %></p>
      <% } %>
      <form
        action="/delete/category/<%= title %>"
        method="POST"
        class="newItemFormWrapper"
      >
        <div>
          <label for="deleteCategoryPassword">Secret Code: </label>
          <input
            type="text"
            id="deleteCategoryPassword"
            name="deleteCategoryPassword"
          />
        </div>
        <button type="submit" class="submitNewItemBtn">Confirm</button>
      </form>
    </div>
  </body>
</html>
