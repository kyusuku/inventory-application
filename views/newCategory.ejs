<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <h1><%= title %></h1>
    <form action="/new/category" method="POST">
      <label for="newMatchaCategory">Matcha Powder Grade: </label>
      <input type="text" name="newMatchaCategory" id="newMatchaCategory" />
      <label for="newMatchaCategoryDesc">Description: </label>
      <textarea
        name="newMatchaCategoryDesc"
        id="newMatchaCategoryDesc"
      ></textarea>
      <button type="submit">Submit</button>
    </form>
  </body>
</html>
